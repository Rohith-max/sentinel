# AI Analysis API Key (Required for AI-powered analysis)
AI_API_KEY=your_groq_api_key_here

# NVD API Key (Optional but recommended for CVE scanning - higher rate limits)
# Get your free API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# GitHub Personal Access Token (Optional - for syncing with remote repositories)
GITHUB_PAT=your_github_personal_access_token_here
